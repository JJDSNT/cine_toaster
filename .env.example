# Cine Toaster: everything it reads from the environment. Copy to `.env` (git-ignored) and fill in what you use;
# commands that send work take it with `--env-file .env`, and `toast doctor` says what is still missing.
# Nothing here is printed by Cine Toaster.

# --- Generation on RunPod serverless (paid; spend is held by `toast budget`) -------------------------------
RUNPOD_API_KEY=                 # account key (console > Settings > API Keys)
RUNPOD_LTX_ENDPOINT_ID=         # image-to-video clips, recipe ltx-2-5 (`toast recipes`)
RUNPOD_QWEN_ENDPOINT_ID=        # master pictures by editing a render, recipe qwen-image-edit
# Before a batch: the endpoint's max workers must be at least 1 (a 0..0 endpoint takes nothing), and its idle
# timeout long enough to keep the worker warm between jobs -- `toast recipes --health ltx-2-5`.

# --- Agent Runtime models (the person's own; Cine Toaster picks none) --------------------------------------
ANTHROPIC_API_KEY=              # only for the claude-api adapter; claude-cli and codex-cli use their own login
# CINE_TOASTER_MODEL=           # adapter for the assistant: claude-cli | claude-api | codex-cli
# CINE_TOASTER_MODEL_ID=        # a specific model for that adapter, when it accepts one

# --- Sound library ------------------------------------------------------------------------------------------
FREESOUND_API_KEY=              # searching freesound.org for effects and ambiences (optional)

# --- Tools found elsewhere (optional; defaults are looked up on PATH) ---------------------------------------
# CINE_TOASTER_BLENDER=/path/to/blender
# CINE_TOASTER_CODEX_CLI=codex
# CINE_TOASTER_NATRON=/path/to/NatronRenderer
# OCIO=/path/to/config.ocio
